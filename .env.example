# Example: http://localhost:8000 (use the port printed by your API).
# Leave empty to explore the read-only preview. Restart Vite after editing.
# Local development forwards /api requests to this address through Vite.
VITE_API_BASE_URL=

# Public URL of the standalone ESP32 lighting API; never add tokens here.
VITE_LIGHTS_API_BASE_URL=http://127.0.0.1:8001
